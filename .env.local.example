# Copy to .env.local (gitignored); `just` loads it. Every variable is optional until a recipe needs it.

# The test line `just sim`, `sim-call` and `sim-checks` call. Use a test agent's line, never your main
# agent's: a test turn keeps that agent busy on your own calls.
TEST_CALL_LINK=https://voice.example.com/voice?t=your-test-line-token

# `just server-logs`: the voice server over ssh and its nanoclaw checkout.
NANOCLAW_SSH=user@voice-server
NANOCLAW_DIR=~/nanoclaw

# `just testflight`: a command prefix that puts ASC_KEY_P8_B64, ASC_KEY_ID and ASC_ISSUER_ID in the
# environment (leave it empty to export them yourself), and the app's Apple ID in App Store Connect.
ASC_ENV_CMD="pass-env asc/hey-dan --"
ASC_APP_ID=1234567890
